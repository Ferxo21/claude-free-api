# Variables de entorno de ejemplo

# URL base si usas Ollama (ej: http://localhost:11434)
OLLAMA_URL=

# Si no usas Ollama, ruta al modelo local (.gguf / .bin / etc.) para llama-cpp-python
MODEL_PATH=/path/to/model.gguf

# Modelo por defecto a reportar en la respuesta
REPORT_MODEL_NAME=local-claude-free

# Parámetros por defecto
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
